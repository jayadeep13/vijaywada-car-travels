# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.vijayawadacartravels.com

# Admin panel PIN (digits only) and the secret that signs the admin session cookie
ADMIN_PIN=your-pin
ADMIN_SESSION_SECRET=a-long-random-string-at-least-32-characters
# Server-only key the PIN-protected admin panel uses to read and save data (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
